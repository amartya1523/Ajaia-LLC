{
  "name": "ajaia-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight collaborative document editor (Ajaia assignment)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "vitest run",
    "seed": "node server/seed.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "multer": "^2.4.0",
    "sanitize-html": "^2.18.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-text-align": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "supertest": "^7.3.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
